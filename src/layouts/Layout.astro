---
import '../styles/global.css';
import '@fortawesome/fontawesome-free/css/all.min.css';
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>Rafli Wahyu — Web Developer & Linux Enthusiast</title>
		<meta
			name="description"
			content="Portfolio Rafli Wahyu — Web Developer dari Jawa Timur yang berfokus pada pengembangan web modern dengan Astro, Laravel, dan Tailwind CSS."
		/>

		<!-- Open Graph -->
		<meta property="og:title" content="Rafli Wahyu — Web Developer & Linux Enthusiast" />
		<meta
			property="og:description"
			content="Portfolio Rafli Wahyu — Web Developer dari Jawa Timur. Astro, Laravel, Tailwind CSS."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://portofolio-livid-eta-98.vercel.app" />
		<meta property="og:image" content="/desktop.png" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Rafli Wahyu — Web Developer & Linux Enthusiast" />
		<meta name="twitter:description" content="Portfolio Rafli Wahyu — Web Developer dari Jawa Timur." />
		<meta name="twitter:image" content="/desktop.png" />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-night-950 font-sans text-slate-200 antialiased">
		<slot />

		<script>
			import 'aos/dist/aos.css';
			import AOS from 'aos';

			window.addEventListener('load', () => {
				AOS.init({
					duration: 800,
					once: true,
					offset: 80,
					easing: 'ease-out-cubic',
				});
			});
		</script>
	</body>
</html>
