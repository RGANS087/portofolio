---
import '../styles/global.css';
import '@fortawesome/fontawesome-free/css/all.min.css';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<title>Rafli Wahyu - Web Developer & Linux Enthusiast</title>
		<meta name="description" content="Portfolio of Rafli Wahyu, a Web Developer and Linux Enthusiast based in Indonesia. Specializing in Astro, Laravel, and Tailwind CSS." />
		
		<!-- Open Graph -->
		<meta property="og:title" content="Rafli Wahyu - Web Developer & Linux Enthusiast" />
		<meta property="og:description" content="Portfolio of Rafli Wahyu, a Web Developer and Linux Enthusiast." />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://raflwahyu.vercel.app" />
		<meta property="og:image" content="/bromo.webp" />
		
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Rafli Wahyu - Web Developer & Linux Enthusiast" />
		<meta name="twitter:description" content="Portfolio of Rafli Wahyu, a Web Developer and Linux Enthusiast." />
		
		<!-- Font -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />

	<script>
		import 'aos/dist/aos.css';
		import AOS from 'aos';
    // Initialize AOS after page fully loaded to ensure dynamic content is captured
    window.addEventListener('load', () => {
  	  AOS.init({
  	    duration: 1000,
  	    once: false,
  	    mirror: true,
  	    easing: "ease-in-out"
  	  });
  	  // Refresh AOS for dynamically loaded content
  	  AOS.refresh();
    });
	</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
		scroll-behavior: smooth;
	}
</style>