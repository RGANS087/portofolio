---
// This component dynamically fetches and displays GitHub repositories
// The actual data is loaded client-side via github-fetch.js
---

<section id="projects" class="py-20 px-6 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-slate-800">Projects</h2>
      <p class="text-slate-600 max-w-2xl mx-auto">
        A selection of my GitHub projects. Each represents a unique challenge and solution.
      </p>
    </div>

    <div id="projects-grid" class="grid md:grid-cols-2 gap-8">
      <!-- Projects will be dynamically loaded here by github-fetch.js -->
      <div class="col-span-2 text-center py-12 text-slate-500">
        Loading projects...
      </div>
    </div>
  </div>
</section>

<script src="/github-fetch.js" is:inline></script>