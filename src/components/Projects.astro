---
const skeletons = Array.from({ length: 3 });
---

<section id="projects" class="relative scroll-mt-24 overflow-hidden bg-night-900 py-24">
	<div class="pointer-events-none absolute inset-0 bg-grid"></div>
	<div
		class="pointer-events-none absolute -top-32 right-0 h-72 w-72 rounded-full bg-amber-500/10 blur-3xl"
	></div>

	<div class="relative mx-auto max-w-6xl px-4 sm:px-6">
		<!-- Heading -->
		<div class="max-w-2xl" data-aos="fade-up">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-400">Proyek</p>
			<h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
				Proyek Pilihan
			</h2>
			<p class="mt-4 leading-relaxed text-slate-400">
				Kumpulan proyek yang pernah saya kerjakan — diambil langsung dari akun GitHub saya.
			</p>
		</div>

		<!-- Grid (diisi oleh github-fetch.js) -->
		<div id="projects-grid" class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				skeletons.map(() => (
					<div class="animate-pulse overflow-hidden rounded-2xl border border-white/5 bg-night-800/60">
						<div class="h-36 bg-white/5"></div>
						<div class="space-y-3 p-6">
							<div class="h-5 w-2/3 rounded bg-white/10"></div>
							<div class="h-4 w-full rounded bg-white/5"></div>
							<div class="h-4 w-5/6 rounded bg-white/5"></div>
							<div class="h-4 w-1/3 rounded bg-amber-400/20"></div>
						</div>
					</div>
				))
			}
		</div>

		<p class="mt-10 text-center text-sm text-slate-500">
			<i class="fa-brands fa-github mr-2"></i>
			Repository publik dari
			<a
				href="https://github.com/RGANS087"
				target="_blank"
				rel="noopener noreferrer"
				class="text-amber-400 transition hover:underline"
			>
				github.com/RGANS087
			</a>
		</p>
	</div>

	<script src="/github-fetch.js" is:inline></script>
</section>
