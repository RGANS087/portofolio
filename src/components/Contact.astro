---
const contacts = [
	{
		icon: 'fa-regular fa-envelope',
		label: 'Email',
		value: 'rafliwahyu@proton.me',
		href: 'mailto:rafliwahyu@proton.me',
	},
	{
		icon: 'fa-brands fa-github',
		label: 'GitHub',
		value: 'github.com/RGANS087',
		href: 'https://github.com/RGANS087',
	},
	{
		icon: 'fa-brands fa-instagram',
		label: 'Instagram',
		value: '@rafl1wahyu__',
		href: 'https://instagram.com/rafl1wahyu__',
	},
	{
		icon: 'fa-solid fa-location-dot',
		label: 'Lokasi',
		value: 'Jawa Timur, Indonesia',
		href: null,
	},
];
---

<section id="contact" class="scroll-mt-24 bg-slate-50 py-24 text-slate-600">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<!-- Heading -->
		<div class="mx-auto max-w-2xl text-center" data-aos="fade-up">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-500">Kontak</p>
			<h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
				Mari Berkolaborasi
			</h2>
			<p class="mt-4 leading-relaxed text-slate-600">
				Saya terbuka untuk peluang kerja, kolaborasi, atau project freelance. Kirim pesan dan
				saya akan membalas sesegera mungkin.
			</p>
		</div>

		<div class="mt-14 grid gap-6 lg:grid-cols-5">
			<!-- Info -->
			<div class="space-y-4 lg:col-span-2">
				{
					contacts.map((item, i) => {
						const inner = (
							<>
								<span
									class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-600"
								>
									<i class={item.icon + ' text-lg'}></i>
								</span>
								<span>
									<span class="block text-sm font-medium text-slate-400">{item.label}</span>
									<span class="mt-0.5 block font-medium text-slate-800">{item.value}</span>
								</span>
							</>
						);

						return item.href ? (
							<a
								href={item.href}
								target={item.href.startsWith('http') ? '_blank' : undefined}
								rel="noopener noreferrer"
								data-aos="fade-right"
								data-aos-delay={i * 80}
								class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-1 hover:border-amber-300 hover:shadow-lg"
							>
								{inner}
							</a>
						) : (
							<div
								data-aos="fade-right"
								data-aos-delay={i * 80}
								class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-5"
							>
								{inner}
							</div>
						);
					})
				}

				<!-- Info tambahan -->
				<div data-aos="fade-right" class="rounded-2xl border border-amber-200 bg-amber-50 p-5">
					<p class="flex items-start gap-3 text-sm text-amber-800">
						<i class="fa-regular fa-clock mt-0.5"></i>
						Saya biasanya membalas pesan dalam 1&times;24 jam pada hari kerja.
					</p>
				</div>
			</div>

			<!-- Form -->
			<div
				data-aos="fade-left"
				class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm lg:col-span-3"
			>
				<h3 class="font-display text-lg font-semibold text-slate-900">Kirim Pesan</h3>
				<p class="mt-1 text-sm text-slate-500">
					Isi formulir di bawah — pesan Anda akan dibuka di aplikasi email.
				</p>

				<form id="contact-form" class="mt-6 space-y-5">
					<div class="grid gap-5 sm:grid-cols-2">
						<div>
							<label for="name" class="mb-1.5 block text-sm font-medium text-slate-700">
								Nama
							</label>
							<input
								type="text"
								id="name"
								name="name"
								required
								placeholder="Nama Anda"
								class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 outline-none transition placeholder:text-slate-500 focus:border-amber-400 focus:bg-white focus:ring-4 focus:ring-amber-400/10"
							/>
						</div>
						<div>
							<label for="email" class="mb-1.5 block text-sm font-medium text-slate-700">
								Email
							</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								placeholder="email@contoh.com"
								class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 outline-none transition placeholder:text-slate-500 focus:border-amber-400 focus:bg-white focus:ring-4 focus:ring-amber-400/10"
							/>
						</div>
					</div>
					<div>
						<label for="message" class="mb-1.5 block text-sm font-medium text-slate-700">
							Pesan
						</label>
						<textarea
							id="message"
							name="message"
							rows="5"
							required
							placeholder="Ceritakan kebutuhan atau pesan Anda..."
							class="w-full resize-none rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 outline-none transition placeholder:text-slate-500 focus:border-amber-400 focus:bg-white focus:ring-4 focus:ring-amber-400/10"
						></textarea>
					</div>
					<button
						type="submit"
						class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-amber-400 px-7 py-3.5 text-sm font-semibold text-night-950 shadow-lg shadow-amber-500/25 transition hover:bg-amber-300 sm:w-auto"
					>
						<i class="fa-regular fa-paper-plane"></i>
						Kirim Pesan
					</button>
				</form>
			</div>
		</div>
	</div>

	<script>
		// Formulir diarahkan ke mailto (tanpa backend)
		const form = document.getElementById('contact-form');
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const data = new FormData(form);
			const name = encodeURIComponent(data.get('name'));
			const email = encodeURIComponent(data.get('email'));
			const message = encodeURIComponent(data.get('message'));

			const subject = `Pesan Portfolio dari ${decodeURIComponent(name)}`;
			const body = `${decodeURIComponent(message)}\n\n— ${decodeURIComponent(name)}\n${decodeURIComponent(email)}`;

			window.location.href = `mailto:rafliwahyu@proton.me?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
		});
	</script>
</section>
